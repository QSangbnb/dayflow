# Your Orbio key. Claim it on orbio.so and paste only the raw sk-orbio-... value.
ORBIO_API_KEY=

# Optional. DayFlow already defaults to this Orbio OpenAI-compatible endpoint.
ORBIO_BASE_URL=https://api.orbio.so/api/v1

# Optional. Model identifier supported by the Orbio gateway.
ORBIO_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional. Identifies your app to the inference gateway.
APP_NAME=DayFlow Agent
APP_URL=http://localhost:5173

# Optional. Maximum simultaneous paid inference requests.
PAID_CONCURRENCY_MAX=2

# Optional. Maximum requests per visitor in a rolling 10-minute window.
RATE_LIMIT_MAX=6

# Optional. When set, paid endpoints require this value in x-demo-access-code.
DEMO_ACCESS_CODE=
